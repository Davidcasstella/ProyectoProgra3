    }
  ],
  "item": [
    {
      "name": "1. AUTENTICACIÓN",
      "item": [
        {
          "name": "1.1 Registrar Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('admin_token', jsonData.token);",
                  "    pm.environment.set('admin_id', jsonData.id);",
                  "    console.log('Token Admin guardado: ' + jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin Principal\",\n  \"email\": \"admin@zygo.com\",\n  \"password\": \"admin123\",\n  \"telefono\": \"3101234567\",\n  \"direccion\": \"Oficina Central Sogamoso\",\n  \"tipo\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Registrar Cliente",
