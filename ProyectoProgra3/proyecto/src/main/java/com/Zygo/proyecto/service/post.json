              "path": ["api", "pedidos", "cliente", "{{cliente_id}}"]
            }
          }
        },
        {
          "name": "4.5 Pedidos por Repartidor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/repartidor/{{repartidor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos", "repartidor", "{{repartidor_id}}"]
            }
          }
        },
        {
          "name": "4.6 Listar Pedidos Pendientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/pendientes",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos", "pendientes"]
            }
          }
        },
        {
          "name": "4.7 Asignar Repartidor a Pedido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/{{pedido_id}}/asignar/{{repartidor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos", "{{pedido_id}}", "asignar", "{{repartidor_id}}"]
            }
          }
        },
        {
          "name": "4.8 Actualizar Estado - EN_CAMINO",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/{{pedido_id}}/estado?estado=EN_CAMINO",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos", "{{pedido_id}}", "estado"],
              "query": [
                {
                  "key": "estado",
                  "value": "EN_CAMINO"
                }
              ]
            }
          }
        },
        {
          "name": "4.9 Actualizar Estado - ENTREGADO",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/{{pedido_id}}/estado?estado=ENTREGADO",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos", "{{pedido_id}}", "estado"],
              "query": [
                {
                  "key": "estado",
                  "value": "ENTREGADO"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. CÁLCULO DE RUTAS",
      "item": [
        {
          "name": "5.1 Calcular Ruta Óptima",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rutas/optima?origenId=1&destinoId=5&considerarTrafico=true",
              "host": ["{{base_url}}"],
              "path": ["api", "rutas", "optima"],
              "query": [
                {
                  "key": "origenId",
                  "value": "1",
                  "description": "ID del nodo origen"
                },
                {
                  "key": "destinoId",
                  "value": "5",
                  "description": "ID del nodo destino"
                },
                {
                  "key": "considerarTrafico",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "5.2 Calcular Rutas Múltiples",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[2, 5, 8, 12]"
            },
            "url": {
              "raw": "{{base_url}}/api/rutas/multiples?origenId=1",
              "host": ["{{base_url}}"],
              "path": ["api", "rutas", "multiples"],
              "query": [
                {
                  "key": "origenId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "5.3 Ruta para Pedido Específico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rutas/pedido/{{pedido_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "rutas", "pedido", "{{pedido_id}}"]
            }
          }
        },
        {
          "name": "5.4 Rutas Pendientes de Repartidor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rutas/repartidor/{{repartidor_id}}/pendientes",
              "host": ["{{base_url}}"],
              "path": ["api", "rutas", "repartidor", "{{repartidor_id}}", "pendientes"]
            }
          }
        },
        {
          "name": "5.5 Actualizar Factor de Tráfico",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rutas/trafico/1?factorTrafico=1.5",
              "host": ["{{base_url}}"],
              "path": ["api", "rutas", "trafico", "1"],
              "query": [
                {
                  "key": "factorTrafico",
                  "value": "1.5",
                  "description": "1.0 = normal, >1.0 = más tráfico"
                }
              ]
            }
          }
        },
        {
          "name": "5.6 Información de Tráfico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rutas/trafico/info",
              "host": ["{{base_url}}"],
              "path": ["api", "rutas", "trafico", "info"]
            }
          }
        }
      ]
    }
  ]
}