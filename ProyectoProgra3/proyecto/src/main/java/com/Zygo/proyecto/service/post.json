    },
    {
      "name": "3. CONFIGURACIÓN DEL GRAFO (ADMIN)",
      "item": [
        {
          "name": "3.1 Test Conexión OSM",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/osm/test-conexion",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "osm", "test-conexion"]
            }
          }
        },
        {
          "name": "3.2 Reiniciar Grafo (Importar Sogamoso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/osm/reiniciar-grafo?incluirResidenciales=true",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "osm", "reiniciar-grafo"],
              "query": [
                {
                  "key": "incluirResidenciales",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "3.3 Estado del Grafo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/osm/estado-grafo",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "osm", "estado-grafo"]
            }
          }
        },
        {
          "name": "3.4 Limpiar Grafo (PELIGRO)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/osm/limpiar-grafo",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "osm", "limpiar-grafo"]
            }
          }
        }
      ]
    },
    {
      "name": "4. GESTIÓN DE PEDIDOS",
      "item": [
        {
          "name": "4.1 Crear Pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('pedido_id', jsonData.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{cliente_id}},\n  \"descripcion\": \"Envío de documentos importantes\",\n  \"direccionOrigen\": \"Centro Comercial Sogamoso\",\n  \"direccionDestino\": \"Universidad Pedagógica Sogamoso\",\n  \"distanciaKm\": 3.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos"]
            }
          }
        },
        {
          "name": "4.2 Obtener Pedido por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/{{pedido_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos", "{{pedido_id}}"]
            }
          }
        },
        {
          "name": "4.3 Listar Todos los Pedidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": ["{{base_url}}"],
              "path": ["api", "pedidos"]
            }
          }
        },
