              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez Actualizado\",\n  \"email\": \"juan@gmail.com\",\n  \"telefono\": \"3201234567\",\n  \"direccion\": \"Calle 10 #5-20, Sogamoso - Actualizado\",\n  \"tipo\": \"CLIENTE\",\n  \"activo\": true\n}"
            },
            "url": {
